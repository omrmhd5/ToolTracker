# Demo environment (never commit real secrets)
# Local Docker Postgres (port 5433):
# DATABASE_URL=postgresql://tooltracker:tooltracker@localhost:5433/tooltracker
#
# Neon (pooled) for Vercel:
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Auth.js — generate a new secret for demo (do not reuse production)
# openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3000

# Production demo URL after Vercel deploy:
# AUTH_URL=https://tooltracker-demo.vercel.app
